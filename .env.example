# ---- LLM / VLM / Embedding (OpenAI-compatible, universal via ENV) ----
# Gateway 9router lokal (model ag/*). catatan: selalu kirim stream:false.
# VLM_MODEL WAJIB dukung input video+audio (Gemini/GPT-4o class) — pipeline
# mengirim segmen mp4 base64 dengan audio di dalamnya, bukan still frame.
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=
MODEL_NAME=ag/gemini-3.6-flash-high
VLM_MODEL=ag/gemini-3.6-flash-high
# model cadangan dipakai otomatis kalau MODEL_NAME gagal (koma, boleh kosong)
LLM_FALLBACK_MODELS=
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2

# ---- Server ----
PORT=3132

# ---- Pipeline tuning ----
SFX_MIN_GAP_SEC=5
SFX_MAX_PER_BEAT=1
RENDER_LEAD_MS=-120

# ---- FX (efek visual + audio) ----
# Stage fx: LLM merencanakan efek → sidecar Rust (fx-renderer, fframes/Skia)
# me-render video + vfx → FFmpeg menggabung audio (SFX + afx gate).
# Set FX_DISABLED=1 untuk melewati seluruh stage fx.
# Path toolchain (defaults mesin ini ada di src/fxruntime.ts, bisa dioverride):
# FX_CARGO_HOME, FX_TARGET_DIR, FX_FFMPEG_DIR, FX_LIBCLANG_PATH, FX_TMP
FX_DISABLED=
