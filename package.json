{
  "name": "autotimingsfx",
  "version": "0.1.0",
  "description": "AutoTimingSFX — AI timing picker untuk SFX library sendiri (transkrip + visual → manifest → FFmpeg)",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "dev:studio": "npm --prefix studio run dev",
    "build:studio": "npm --prefix studio run build",
    "typecheck": "tsc --noEmit && npm --prefix studio run typecheck --if-present",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
